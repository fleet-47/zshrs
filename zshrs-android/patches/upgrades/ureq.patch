+// Preserve ureq 2's byte cap and MIME-independent lossy UTF-8 decoding.
+fn response_text(body: &mut ureq::Body) -> std::io::Result<String> {
+    use std::io::Read;
+
+    const LIMIT: u64 = 10 * 1024 * 1024;
+    let mut bytes = Vec::new();
+    body.as_reader().take(LIMIT + 1).read_to_end(&mut bytes)?;
+    if bytes.len() as u64 > LIMIT {
+        return Err(std::io::Error::other("response too big for into_string"));
+    }
+    Ok(String::from_utf8_lossy(&bytes).into_owned())
+}
