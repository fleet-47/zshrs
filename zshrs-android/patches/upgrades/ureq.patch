+fn invalid_optional_json_keeps_upstream_ping_dispatch() {
+    let d = DaemonHttp::spawn(None);
+    for (content_type, payload) in [
+        ("application/json", "{"),
+        ("text/plain", "{\"echo\": \"must not be parsed\"}"),
+    ] {
+        let resp = http_agent().post(&d.url("/op/ping"))
+            .header("Content-Type", content_type)
+            .send(payload)
+            .expect("invalid optional JSON still dispatches ping");
+        assert_eq!(resp.status(), 200, "{content_type}");
+        let body: serde_json::Value =
+            serde_json::from_reader(resp.into_body().into_reader()).expect("json");
+        assert_eq!(body["ok"], serde_json::json!(true));
+        assert_eq!(body["pong"], serde_json::json!(true));
+        assert_eq!(body["echo"], serde_json::Value::Null);
+    }
+}
