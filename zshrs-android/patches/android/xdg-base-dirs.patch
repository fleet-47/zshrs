+// Included by `daemon/paths.rs` and `src/extensions/daemon_presence.rs`; the
+// shell's `zshrs-daemon` dependency is optional. Paths are fully qualified.
+
+/// On Android, default `$ZSHRS_HOME` to `$XDG_STATE_HOME/zshrs` (state, not
+/// cache: Android may evict `$XDG_CACHE_HOME`). Call before any path resolves.
+pub fn apply_android_xdg_defaults() {
+    if !cfg!(target_os = "android") || std::env::var_os("ZSHRS_HOME").is_some() {
+        return;
+    }
+    if let Some(root) = android_default_root() {
+        std::env::set_var("ZSHRS_HOME", root);
+    }
+}
+
+/// `$XDG_STATE_HOME/zshrs`, else `~/.local/state/zshrs`.
+fn android_default_root() -> Option<std::path::PathBuf> {
+    let state = match std::env::var_os("XDG_STATE_HOME") {
+        Some(s) if !s.is_empty() => std::path::PathBuf::from(s),
+        _ => std::path::PathBuf::from(std::env::var_os("HOME")?).join(".local").join("state"),
+    };
+    Some(state.join("zshrs"))
+}
+
+/// `$XDG_CONFIG_HOME/zshrs` (else `~/.config/zshrs`) when `root` is the Android
+/// default root, otherwise `root`. Compared by value so child processes that
+/// inherit `$ZSHRS_HOME` resolve identically.
+pub fn config_dir(root: &std::path::Path) -> std::path::PathBuf {
+    if cfg!(target_os = "android") && android_default_root().as_deref() == Some(root) {
+        let base = match std::env::var_os("XDG_CONFIG_HOME") {
+            Some(c) if !c.is_empty() => Some(std::path::PathBuf::from(c)),
+            _ => std::env::var_os("HOME").map(|h| std::path::PathBuf::from(h).join(".config")),
+        };
+        if let Some(base) = base {
+            return base.join("zshrs");
+        }
+    }
+    root.to_path_buf()
+}
